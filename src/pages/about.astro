---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"About Muhammad Usman Safder - Senior AI/ML Specialist, AI Research Engineer, and FinTech Consultant",
	title: "About",
};

const skills = [
	"Multi-Agent Architectures (LangGraph, CrewAI)",
	"LLM Red Teaming, Safety & Benchmarking (LibrAI)",
	"Retrieval-Augmented Generation (RAG) & Vector DBs",
	"Financial AI & Compliance Automation (ADCB Bank)",
	"Deep Learning & NLP (PyTorch, TensorFlow)",
	"Full-Stack Systems (React, Next.js, Node.js, FastAPI)",
	"Cloud Infrastructure & MLOps (AWS EKS, OCI OKE, Kubernetes, Docker, Terraform)",
	"Observability & Evaluation (Langfuse, Langsmith, Prometheus)",
];

const researchFocus = [
	"Symbolic Benchmarks for Verifiable Engineering Reasoning (EngTrace — ACL ARR 2026)",
	"Financial Intelligence & Cross-Jurisdiction Reporting (Herculean @ NeurIPS 2026, FinReporting @ ACL 2026)",
	"Adversarial Safety Testing & Red Teaming on 70B Open Models (K2 / K2-Think LLM360)",
	"Imbalanced Machine Learning & Genetic Algorithms (Nature Scientific Reports)",
	"Computer Vision & 3D Reconstruction (Nature Scientific Reports)",
];

const interests = [
	"Developing open-source observability and benchmarking tools (Infrahealth CLI, Findodo)",
	"Bridging academia and industry through EdTech innovation (!Nash Founder)",
	"Community leadership as President of the Namal Computing Society",
	"Mentoring students in Machine Learning, Computer Networks, and Cloud Infrastructure",
];
---

<PageLayout meta={meta}>
	<div class="space-y-6">
		<h1 class="title text-3xl font-bold">About Me</h1>
		<p class="text-base leading-relaxed">
			Hi! I'm <strong>Muhammad Usman Safder</strong>, a Senior AI/ML Specialist, AI Research Engineer, and FinTech Consultant. 
			I specialize in building and deploying production-grade AI systems, multi-agent LLM architectures, context-aware RAG pipelines, 
			and scalable cloud infrastructure across enterprise, research, and startup ecosystems.
		</p>

		<p class="leading-relaxed">
			My recent work spans engineering complex enterprise multi-agent platforms at <strong>Diyar United Company</strong>, conducting 
			adversarial safety red teaming and LLM evaluation harnesses at <strong>LibrAI</strong>, advising on financial disclosure reporting workflows 
			at <strong>ADCB Bank (Abu Dhabi Commercial Bank)</strong>, and co-authoring cutting-edge AI reasoning papers under MBZUAI's NLP group in the UAE.
		</p>

		<div class="mt-8">
			<h2 class="mb-4 text-xl font-semibold">Technical Expertise</h2>
			<ul class="grid list-inside list-disc grid-cols-1 gap-2 md:grid-cols-2 text-sm">
				{skills.map((skill) => <li>{skill}</li>)}
			</ul>
		</div>

		<div class="mt-8">
			<h2 class="mb-4 text-xl font-semibold">Research & Key Focus Areas</h2>
			<ul class="list-inside list-disc space-y-2 text-sm">
				{researchFocus.map((item) => <li>{item}</li>)}
			</ul>
		</div>

		<div class="mt-8">
			<h2 class="mb-4 text-xl font-semibold">Education & Academic Leadership</h2>
			<div class="border-l-2 border-accent pl-4 space-y-2">
				<p class="font-bold">Namal University — BS in Computer Science</p>
				<p class="text-xs text-textColor/70">Nov 2021 – July 2025 | CGPA: 3.54 / 4.0</p>
				<ul class="list-disc list-inside text-sm mt-1">
					<li>President, Namal Computing Society (2025)</li>
					<li>Teaching & Lab Assistant for Computer Networks, DevOps, and ML</li>
					<li>2nd Position — National AI Nexus Hackathon (LUMS University, 2024)</li>
					<li>3rd Position — National CS Competition (COMSATS University, 2024)</li>
				</ul>
			</div>
		</div>

		<div class="mt-8">
			<h2 class="mb-4 text-xl font-semibold">Beyond Tech</h2>
			<ul class="list-inside list-disc space-y-1 text-sm">
				{interests.map((interest) => <li>{interest}</li>)}
			</ul>
		</div>

		<p class="mt-8">
			Want to collaborate or discuss AI research? Feel free to reach out via my social links or send me an 
			<span class="cactus-link inline-block"><a href="mailto:usmansafderktk@gmail.com" rel="noreferrer" target="_blank">email</a></span>!
		</p>
	</div>
</PageLayout>

